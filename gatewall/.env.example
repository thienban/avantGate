# gateWall - Configuration Environnement (Self-Hosted Open-Source)

# Port d'écoute du serveur (Défaut : 3000)
PORT=3000

# Environnement (development ou production)
NODE_ENV=production

# Clé d'API secrète par défaut pour tester en local
GATEWALL_API_KEY=gw_live_dev_test_key_123456789

# Clé d'API publique pour le SDK navigateur
NEXT_PUBLIC_GATEWALL_PUBLIC_KEY=gw_pub_prospect_ai_123456789

# URL de la passerelle
NEXT_PUBLIC_GATEWALL_URL=http://localhost:3000
